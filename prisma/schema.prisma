generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Todo ──────────────────────────────────────────────────────────────────────
model Todo {
  id        String      @id @default(cuid())
  text      String
  tag       String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  subItems  TodoSubItem[]
}

model TodoSubItem {
  id      String  @id @default(cuid())
  todoId  String
  text    String
  checked Boolean @default(false)
  todo    Todo    @relation(fields: [todoId], references: [id], onDelete: Cascade)
}

// ── Lists ─────────────────────────────────────────────────────────────────────
// Single-row JSONB store — id is always 'family'
model ListsState {
  id    String @id @default("family")
  data  Json
}

// ── Packing (legacy family checklist) ─────────────────────────────────────────
model PackingState {
  id   String @id @default("family")
  data Json
}

// ── Packing (trip-based) ──────────────────────────────────────────────────────
// Templates are the reusable list of tabs/sections/items. Three rows:
//   id = "shared"  → tabs shared across users (pretrip, tech, camping, food, kids, car)
//   id = "mel"     → per-user tabs for Mel (clothing, health)
//   id = "kathy"   → per-user tabs for Kathy (clothing, health)
model PackingTemplate {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// One row per trip. `state` is a flat { key -> true } check-map. Keys are of
// the form "<scope>:<itemId>" where scope is "shared" | "mel" | "kathy".
model PackingTrip {
  id        String   @id @default(cuid())
  name      String
  tripDate  DateTime
  camping   Boolean  @default(false)
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Jo Schedule ───────────────────────────────────────────────────────────────
model JoScheduleState {
  id   String @id @default("family")
  data Json
}

// ── Budget Snapshots ──────────────────────────────────────────────────────────
// One row per profile name
model BudgetSnapshot {
  id   String @id
  data Json
}

// ── Calendar ──────────────────────────────────────────────────────────────────
model CalendarState {
  id   String @id @default("family")
  data Json
}

// ── Music ─────────────────────────────────────────────────────────────────────
// Practice tracker. Four users (kathy/mel/jo/duo — duo is a shared "user" for
// kathy+mel duet sessions and gets its own ratings/sessions/history).
model Song {
  id        String        @id @default(cuid())
  title     String
  genre     String        // "oldtime" | "bluegrass" | "jazz" | "blues"
  key       String?       // "C" | "A" | "G" | "D" | ...  — oldtime only for now
  tag       String        @default("duo") // "duo" | "kathy" | "mel" | "jo"
  artist    String?
  notes     String?
  createdAt DateTime      @default(now())
  ratings   SongRating[]
  sessions  SessionSong[]

  @@unique([title, genre])
}

model SongRating {
  id     String @id @default(cuid())
  songId String
  user   String // "kathy" | "mel" | "jo" | "duo"
  rating String @default("unknown") // "unknown" | "learning" | "known"
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, user])
}

model PracticeSession {
  id        String        @id @default(cuid())
  user      String        // "kathy" | "mel" | "jo" | "duo"
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  songs     SessionSong[]

  // Partial unique index (WHERE "endedAt" IS NULL) enforced in migration SQL.
  @@index([user, endedAt])
}

model SessionSong {
  id        String          @id @default(cuid())
  sessionId String
  songId    String
  playedAt  DateTime        @default(now())
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  song      Song            @relation(fields: [songId], references: [id])

  @@unique([sessionId, songId])
}

// ── Health ────────────────────────────────────────────────────────────────────
model HealthEvent {
  id         String   @id @default(cuid())
  person     String
  text       String
  type       String   // "positive" | "negative" | "neutral"
  tag        String   @default("other")
  // Optional structured extras. Common shapes:
  //   tag = "medication":
  //     { medication, fromDose, toDose, effectiveDate }         (dose change)
  //     { fromMedication, fromDose, toMedication, toDose, effectiveDate }  (switch)
  //     { medication, regimen }                                  (ongoing regimen)
  //   tag = "test":
  //     { testName, result, unit, referenceRange, flag }
  data       Json?
  // The date the event actually occurred (user-supplied). Defaults to now
  // for entries logged the day they happen. Separate from createdAt (audit).
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
}
